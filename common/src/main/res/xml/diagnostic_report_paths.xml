<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="reports" path="diagnostic-reports/" />
    <external-files-path name="external_reports" path="diagnostic-reports/" />
    <!--
        The app's own cache, which is where the update link writes its package, and the external one
        for the same folder when the car has mounted storage. Both are inside the app's own sandbox:
        nothing outside it is reachable through this provider.

        The pattern is the one a file manager already on this car (com.cxinventor.file.explorer)
        uses for its own cache, and its dex hands a package over with ACTION_INSTALL_PACKAGE. This
        provider is here for that handover.
    -->
    <cache-path name="updates" path="." />
    <external-cache-path name="external_updates" path="." />
</paths>
